# Copy to .env and fill in.
#
# IMAGE_PROVIDER defaults to 'remote'. With 'remote' and no API key / base URL,
# generation is REFUSED (503 GENERATION_UNAVAILABLE) — the local pixel engine is
# never a stand-in for an unconfigured paid model. Key and base URL can also be
# set from the admin panel (hot, no restart).
#
# IMAGE_PROVIDER=local runs the built-in pixel engine only — dev / offline use,
# not for a public deployment: its output is a filter pass, not a model result.
IMAGE_PROVIDER=remote
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=gpt-image-2
IMAGE_PROVIDER_TIMEOUT_MS=180000

# 远程生成失败时是否回落本地像素引擎。默认 false：失败即失败并退回额度，
# 绝不用滤镜结果冒充模型输出。也可在后台 local_engine_fallback 热改。
LOCAL_ENGINE_FALLBACK=false

# ─── 收费模型（2026-09）────────────────────────────────────────────────
# 邮箱注册后送 FREE_UNITS 张（默认 3）；游客只能浏览，不发免费额度
# （FREE_REQUIRES_AUTH=true）。额度用完后 App 展示 SUPPORT_EMAIL 请用户来信，
# 管理员在后台「用户」页手动加额度（POST /v1/admin/users/grant）。
# 三项都可在后台热改；后台改过的值存 app_config 表，优先于这里。
FREE_UNITS=3
FREE_REQUIRES_AUTH=true
SUPPORT_EMAIL=donaldkuke@gmail.com
SUPPORT_QQ_GROUP=824558022

# 免费额度防白嫖上限（滚动 24 小时，后台可热改；任一设 0 = 完全停发免费额度）。
# 游客必须带 deviceId 才可能拿到免费额度，且同一设备/身份只发一次。
FREE_GRANTS_PER_IP_DAY=3
FREE_GRANTS_PER_DAY=50

# 开发专用，生产必须 false。即使为 true 也还要带管理员令牌才生效：
# ALLOW_MOCK_PURCHASES 是「凭空发额度」，ALLOW_TEST_LOGIN 是「任意邮箱冒充登录」。
ALLOW_MOCK_PURCHASES=false
ALLOW_TEST_LOGIN=false

# ─── 反向代理与客户端 IP（安全审计 2026-09-02，F02/F39）────────────────────
# 限流、免费额度 IP 上限都按「客户端 IP」计数。之前直接读 cf-connecting-ip 和
# x-forwarded-for 的第一段——两者都是调用方可以随便写的，等于没有限流。
#
# TRUSTED_PROXY 决定「什么样的 TCP 对端才配让我信它的转发头」：
#   private（默认）回环 + RFC1918 + ULA。正是当前部署形态：Caddy 在宿主机上
#                   反代 127.0.0.1:8787，容器看到的对端是 docker 网桥网关。
#   none            谁都不信，一律用 socket 地址（全站共用一个限流桶，慎用）。
#   *               信任所有对端（只有在你完全掌控前置代理时才可以）。
#   1.2.3.4,5.6.7.8 只信任这些确切地址。
# 信任成立时只取 x-forwarded-for 的【最后一段】——那是可信代理自己追加的，
# 也是调用方唯一改不了的一段。Caddy 默认是「追加」而非「覆盖」，符合要求。
TRUSTED_PROXY=private

# 是否信任 cf-connecting-ip。默认 false。只有当 Caddy 已经用
# `header_up -CF-Connecting-IP` 剥掉客户端自带的同名头、且源站不能被绕过
# Cloudflare 直连时，才可以设为 true。
TRUST_CF_CONNECTING_IP=false

# 限流表的键上限，防止伪造 IP 把内存撑爆（超出后按插入顺序淘汰）。
RATE_LIMIT_MAX_KEYS=50000

# ─── 密钥与会话 ────────────────────────────────────────────────────────
# 免费额度表里 IP 只存加盐哈希。盐以前取自 ADMIN_TOKEN（默认空 = 无盐）。
# 留空则自动生成一个持久化的随机盐（存在 server_secrets 表），无需人工设置；
# 显式设置后轮换 ADMIN_TOKEN 不会再重置免费额度计数。
IP_HASH_SALT=

# 会话有效期（天）。以前会话永不过期，泄漏一次就是永久凭据。
SESSION_TTL_DAYS=90

# 单账号图片存储上限（字节），默认 256 MB。
MAX_USER_STORAGE_BYTES=268435456

# ─── Worker 与关机 ──────────────────────────────────────────────────────
# 单个任务最多尝试几次。超过就直接判失败并退回额度，避免「崩溃 → 重启 →
# 再跑同一个任务 → 再崩溃」的死循环（每一圈都在真金白银地调用图像接口）。
MAX_JOB_ATTEMPTS=3

# 收到 SIGTERM 后的最长排空时间（毫秒）。docker compose 默认只等 10s，
# 建议在 docker-compose.yml 里配 `stop_grace_period: 30s` 与之匹配。
SHUTDOWN_GRACE_MS=25000

# 遥测 events 表保留天数（启动时 + 每天清理一次）。
EVENT_RETENTION_DAYS=90

# ─── 邮件与图像服务商 ───────────────────────────────────────────────────
# SMTP 连接超时（毫秒）。没有它时，一个被黑洞路由的 SMTP 主机会让
# /v1/auth/email/request 挂 2–10 分钟。
SMTP_CONNECTION_TIMEOUT_MS=10000

# Node 的 fetch(undici) 自带 300s headersTimeout，进程内无法调高。
# image_provider_timeout_ms 会被夹到这个上限，免得配了 420s 却在 300s 断线
# （模型那边照样出图照样计费，我们却收不到）。真要更长必须引入 undici 依赖。
UNDICI_HEADERS_TIMEOUT_MS=290000

# ─── Google Play ───────────────────────────────────────────────────────
# 是否由服务端调用 Play 的 acknowledge。Play 规定 3 天内未确认的购买会自动退款。
# 默认 false：客户端的计费插件通常已在设备上确认/消费，重复确认会报错。
# 决定权在运维——详见 AUDIT-2026-09-02.md「待定决策」。设为 false 时，遇到
# 未确认的购买会打 WARN 日志，方便先观察再决定。
PLAY_ACKNOWLEDGE=false
