# Copy to .env and fill in.
#
# IMAGE_PROVIDER defaults to 'remote'. With 'remote' and no API key / base URL,
# generation is REFUSED (503 GENERATION_UNAVAILABLE) — the local pixel engine is
# never a stand-in for an unconfigured paid model. Key and base URL can also be
# set from the admin panel (hot, no restart).
#
# IMAGE_PROVIDER=local runs the built-in pixel engine only — dev / offline use,
# not for a public deployment: its output is a filter pass, not a model result.
IMAGE_PROVIDER=remote
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=gpt-image-2
IMAGE_PROVIDER_TIMEOUT_MS=180000

# 远程生成失败时是否回落本地像素引擎。默认 false：失败即失败并退回额度，
# 绝不用滤镜结果冒充模型输出。也可在后台 local_engine_fallback 热改。
LOCAL_ENGINE_FALLBACK=false
