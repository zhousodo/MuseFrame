# MuseFrame API（新增服务，独立文件，不改动 LensCript 任何配置）
# 后端进程只监听 127.0.0.1:8787；ufw 不放行 8787，公网入口仅此文件。
#
# 正式客户端只使用 HTTPS 域名；不要重新加入 nip.io 明文入口，它会绕过
# Cloudflare/HSTS 并把 Bearer 凭证暴露给链路监听者。

http://museframe.lenscript.cn {
	redir https://museframe.lenscript.cn{uri} permanent
}

museframe.lenscript.cn {
	tls internal
	reverse_proxy 127.0.0.1:8787 {
		# Caddy 会自行追加可信的 X-Forwarded-For；不要把客户端可伪造的
		# Cloudflare 专用头原样送到应用。
		header_up -CF-Connecting-IP
		transport http {
			dial_timeout 3s
			response_header_timeout 60s
		}
	}
}
