# MuseFrame 运行环境变量。真实文件 project.env 权限必须是 600。
#
# 🔴 密钥红线：IMAGE_PROVIDER_API_KEY / SMTP_PASS / ADMIN_TOKEN 只存在于本文件。
#    Go 版**不再**从数据库读这三类值，后台也改不了它们（PUT /v1/admin/config 返回 422）。
#    迁移时 app_config 里遗留的 image_provider_api_key / smtp_pass 行必须删掉，
#    不要迁进 PG。

# ---- 数据库（运行角色，无 DDL 权限）----
MUSEFRAME_DATABASE_URL=postgres://museframe_app:<PASSWORD>@platform-postgres:5432/museframe?sslmode=disable
MUSEFRAME_DATABASE_POOL_MAX_CONNS=4

# ---- 服务 ----
PORT=8787
HOST=0.0.0.0
MUSEFRAME_ASSET_DIR=/var/lib/museframe/assets
# 静态 SPA 由边缘代理托管时留空；留空时非 /v1/* 路径一律 404（不返回软 404 的 200 HTML）
MUSEFRAME_WEB_DIR=
SHUTDOWN_GRACE_SECONDS=25

# ---- 运维凭据 ----
ADMIN_TOKEN=<REDACTED 32 位随机串>
# 🔴 必填、且必须与 ADMIN_TOKEN 不同。Node 版它回落到 ADMIN_TOKEN，
#    换令牌会让历史 free_grants.ip_hash 全部对不上，24h per-IP 上限被静默重置一次。
#    迁移时请把当前 ADMIN_TOKEN 的值固化到这里，保住历史 ip_hash 的连续性。
IP_HASH_SALT=<REDACTED 独立固化值>

# ---- 上游图像模型 ----
IMAGE_PROVIDER=remote
IMAGE_PROVIDER_BASE_URL=https://gpt.lenscript.cn
IMAGE_PROVIDER_API_KEY=<REDACTED>
IMAGE_PROVIDER_MODEL=gpt-image-2
IMAGE_PROVIDER_TIMEOUT_MS=420000
WORKER_CONCURRENCY=3
PROMPT_COMPILER_MODEL=gpt-5.4-mini
MAX_JOB_ATTEMPTS=3

# ---- 额度与反白嫖（生产冻结基线）----
FREE_UNITS=3
ALLOW_GUEST=false
FREE_REQUIRES_AUTH=true
FREE_GRANTS_PER_IP_DAY=3
FREE_GRANTS_PER_DAY=50
LOCAL_ENGINE_FALLBACK=false

# ---- 三个开发逃生口：生产必须 false（即便为 true 也还要管理员令牌）----
ALLOW_MOCK_PURCHASES=false
ALLOW_TEST_LOGIN=false

# ---- 登录与支付 ----
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PACKAGE_NAME=com.museframe.app

# ---- 邮件 ----
EMAIL_LOGIN_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<REDACTED>
SMTP_PASS=<REDACTED>
SMTP_FROM=MuseFrame <no-reply@lenscript.cn>
SUPPORT_EMAIL=<客服邮箱>
SUPPORT_QQ_GROUP=824558022

# ---- 代理与限流 ----
# 边缘（OpenResty/Caddy）三处回源都必须保留 header_up -CF-Connecting-IP 剥头动作
TRUSTED_PROXY=private
TRUST_CF_CONNECTING_IP=false
RATE_LIMIT_MAX_KEYS=50000

# ---- 保留期 ----
EVENT_RETENTION_DAYS=90
IDEMPOTENCY_RETENTION_DAYS=30
SESSION_TTL_DAYS=90
MAX_USER_STORAGE_BYTES=268435456
